{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "currency": { "type": "string", "enum": ["USD", "EUR", "GBP"] },
        "pushTokens": { "type": "array", "items": { "type": "string" } },
        "pushEnabledAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Asset": {
      "title": "Asset",
      "description": "A financial asset in a portfolio",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["stock", "crypto"] },
        "averagePrice": { "type": "number" },
        "totalQuantity": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["symbol", "type"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A buy or sell operation",
      "type": "object",
      "properties": {
        "assetSymbol": { "type": "string" },
        "type": { "type": "string", "enum": ["buy", "sell"] },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["assetSymbol", "type", "quantity", "price", "userId"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "A favorited market asset",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["stock", "crypto"] },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["symbol", "name", "type"]
    },
    "Alert": {
      "title": "Alert",
      "description": "A user-defined price alert",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "type": { "type": "string", "enum": ["stock", "crypto"] },
        "condition": { "type": "string", "enum": ["above", "below"] },
        "targetPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "paused", "triggered"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastCheckedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["symbol", "type", "condition", "targetPrice", "status", "createdAt"]
    },
    "PortfolioSnapshot": {
      "title": "Portfolio Snapshot",
      "description": "Daily portfolio value snapshot",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "totalValue": { "type": "number" },
        "totalCost": { "type": "number" },
        "totalPnl": { "type": "number" },
        "totalPnlPercent": { "type": ["number", "null"] },
        "livePricedCount": { "type": "number" },
        "holdingsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "totalValue", "totalCost", "totalPnl", "livePricedCount", "holdingsCount", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Server-generated in-app user notification",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["price_alert"] },
        "symbol": { "type": "string" },
        "assetType": { "type": "string", "enum": ["stock", "crypto"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["unread", "read"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "targetPrice": { "type": "number" },
        "currentPrice": { "type": "number" }
      },
      "required": ["type", "symbol", "title", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/users/{userId}/assets/{assetId}": {
      "schema": "Asset",
      "description": "Assets owned by the user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Transaction history for the user"
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": "Favorite",
      "description": "User's favorite assets"
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": "Alert",
      "description": "User-defined price alerts"
    },
    "/users/{userId}/snapshots/{snapshotId}": {
      "schema": "PortfolioSnapshot",
      "description": "Daily portfolio value snapshots"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Server-generated alert notifications"
    }
  }
}
